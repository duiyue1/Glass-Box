{
  "name": "glass-box",
  "version": "0.1.0",
  "description": "可观测、可插拔的迷你 coding agent（玻璃盒）",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.ts",
    "chat": "node --env-file-if-exists=.env src/chat.ts",
    "web": "node --env-file-if-exists=.env src/web.ts",
    "demo": "node --env-file-if-exists=.env src/index.ts \"echo Glass-Box 引擎跑通了\"",
    "tui": "node --env-file-if-exists=.env src/tui.ts",
    "test": "node --test test/*.test.ts",
    "eval": "node --env-file-if-exists=.env src/eval/run.ts",
    "eval:kb": "node --env-file-if-exists=.env src/eval/retrieval.ts",
    "eval:agent": "node --env-file-if-exists=.env src/eval/agent.ts",
    "eval:security": "node --env-file-if-exists=.env src/eval/security.ts",
    "kb:distill": "node --env-file-if-exists=.env src/kbDistill.ts",
    "kb:ctx": "node --env-file-if-exists=.env src/kbContext.ts",
    "kb:wiki": "node --env-file-if-exists=.env src/kbWiki.ts",
    "kb:audit": "node --env-file-if-exists=.env src/kbAudit.ts",
    "typecheck": "tsc --noEmit",
    "replay": "node --env-file-if-exists=.env src/replay.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "typescript": "5.9.2"
  }
}
